<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Gestión de Planes de Estudio</title>
</head>
<body>
    <h1>Planes de Estudio para: {{carrera.nombre}} ({{carrera.codigo}})</h1>
    <a href="/carreras">Volver a Carreras</a> | <a href="/dashboard">Dashboard</a>
    <hr>

    {{#error}}<p style="color: red;"><strong>Error:</strong> {{.}}</p>{{/error}}
    {{#message}}<p style="color: green;">{{.}}</p>{{/message}}

    <h2>Registrar Nuevo Plan</h2>
    <form action="/plan/create" method="POST">
        <input type="hidden" name="carrera_id" value="{{carrera.id}}">
        
        <label>Nombre del Plan:</label>
        <input type="text" name="nombre" placeholder="Ej: Plan 2026" required>
        
        <label>Código Único:</label>
        <input type="text" name="codigo" placeholder="Ej: P-LCC-2026" required>
        
        <button type="submit">Crear Plan</button>
    </form>

    <hr>

    <h2>Planes Vigentes e Historial</h2>
    <ul>
        {{#planes}}
            <li>
                <strong>{{nombre}}</strong> - Código: {{codigo}} | 
                <a href="/plan/{{id}}/materias">Ver/Gestionar Materias</a>
            </li>
        {{/planes}}
        {{^planes}}
            <li>No hay planes de estudio registrados para esta carrera.</li>
        {{/planes}}
    </ul>
</body>
</html>