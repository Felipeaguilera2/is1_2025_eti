<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gestión de Estudiantes - UNRC</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 min-h-screen p-6">
    <div class="max-w-5xl mx-auto bg-white p-8 rounded-xl shadow-lg border border-gray-200">
        
        <div class="flex justify-between items-center mb-6 pb-4 border-b">
            <h1 class="text-3xl font-extrabold text-gray-800 tracking-tight">Administración de Estudiantes</h1>
            <span class="bg-purple-100 text-purple-800 text-xs font-semibold px-2.5 py-0.5 rounded-full">Registro de Alumnos</span>
        </div>

    <title>Inscripción a Materias - UNRC</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 min-h-screen p-6">
    <div class="max-w-4xl mx-auto bg-white p-8 rounded-xl shadow-lg border border-gray-200">

        <div class="flex justify-between items-center mb-6 pb-4 border-b">
            <div>
                <h1 class="text-3xl font-extrabold text-gray-800 tracking-tight">Inscripción a Materias</h1>
                <p class="text-sm text-gray-500 mt-1">Estudiante: <span class="font-bold text-gray-700">{{estudiante.nombre}} {{estudiante.apellido}}</span></p>
            </div>
            <span class="bg-indigo-100 text-indigo-800 text-xs font-semibold px-2.5 py-0.5 rounded-full">Inscripción</span>
        </div>
        {{#successMessage}}
        <div class="bg-green-50 border-l-4 border-green-500 text-green-800 p-4 rounded-md mb-4 shadow-sm">
            <p class="text-sm font-medium">{{successMessage}}</p>
        </div>
        {{/successMessage}}
        
        {{#errorMessage}}
        <div class="bg-red-50 border-l-4 border-red-500 text-red-800 p-4 rounded-md mb-4 shadow-sm">
            <p class="text-sm font-medium">{{errorMessage}}</p>
        </div>
        {{/errorMessage}}

        <div class="bg-gray-50 p-6 rounded-lg border border-gray-200 mb-8">
            <h2 class="text-lg font-bold text-gray-700 mb-4 flex items-center">
                <span class="w-2 h-4 bg-purple-600 rounded-sm inline-block mr-2"></span> Matricular Estudiante (Asignar DNI)
            </h2>
            <form action="/estudiantes/new" method="POST" class="grid grid-cols-1 md:grid-cols-3 gap-4 items-end">
                <div>
                    <label class="block text-xs font-semibold text-gray-600 uppercase tracking-wider">Número de DNI</label>
                    <input type="number" name="dni" placeholder="Ej: 45678912" required 
                           class="w-full mt-1 p-2.5 border rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500 transition shadow-sm bg-white">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-gray-600 uppercase tracking-wider">Código de Estudiante (Legajo)</label>
                    <input type="number" name="cod_estudiante" placeholder="Ej: 22045" required 
                           class="w-full mt-1 p-2.5 border rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500 transition shadow-sm bg-white">
                </div>
                <div>
                    <button type="submit" class="w-full bg-purple-600 hover:bg-purple-700 text-white font-medium py-2.5 rounded-lg shadow transition duration-200">
                        + Registrar Estudiante
                    </button>
                </div>
            </form>
                <p class="text-xs text-gray-400 mt-2">Nota: La persona debe estar previamente dada de alta en el sistema desde la sección 
                    <a href="/person/new" class="text-blue-600 hover:underline">Cargar Persona</a>
                </p>
        </div>

        <div class="overflow-x-auto rounded-lg border border-gray-200 shadow-sm">
            <table class="w-full text-sm text-left text-gray-600">
                <thead class="text-xs text-gray-700 uppercase bg-gray-50 border-b">
                    <tr>
                        <th scope="col" class="px-6 py-3 font-semibold">Código Alumno</th>
                        <th scope="col" class="px-6 py-3 font-semibold">DNI</th>
                        <th scope="col" class="px-6 py-3 font-semibold">Nombre Completo</th>
                        <th scope="col" class="px-6 py-3 text-center font-semibold">Acciones</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200 bg-white">
                    {{#estudiantes}}
                    <tr class="hover:bg-gray-50 transition">
                        <td class="px-6 py-4 font-mono font-medium text-gray-900">{{cod_estudiante}}</td>
                        <td class="px-6 py-4 font-mono">{{dni}}</td>
                        <td class="px-6 py-4 font-medium text-gray-800">{{nombre}} {{apellido}}</td>
                        <td class="px-6 py-4 text-center space-x-2">
                            <a href="/inscripciones/{{id}}" class="inline-flex items-center text-xs bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-3 py-1.5 rounded-md shadow transition duration-200">
                                Inscribirse a Materias
                            </a>
                            
                            <a href="/estudiantes/edit/{{id}}" class="inline-flex items-center text-xs bg-yellow-50 hover:bg-yellow-100 text-yellow-700 font-semibold px-3 py-1.5 rounded-md border border-yellow-200 transition">
                                Modificar
                            </a>
                            <a href="/estudiantes/delete/{{id}}" onclick="return confirm('¿Estás seguro de dar de baja a este estudiante?')" 
                               class="inline-flex items-center text-xs bg-red-50 hover:bg-red-100 text-red-600 font-semibold px-3 py-1.5 rounded-md border border-red-200 transition">
                                Eliminar
                            </a>
                        </td>
                    </tr>
                    {{/estudiantes}}

                    {{^estudiantes}}
                    <tr>
                        <td colspan="4" class="px-6 py-10 text-center text-gray-400 italic bg-gray-50">
                            No hay estudiantes matriculados en el sistema actualmente.
                        </td>
                    </tr>
                    {{/estudiantes}}
        <!-- Formulario de inscripción -->
        <div class="bg-gray-50 p-6 rounded-lg border border-gray-200 mb-8">
            <h2 class="text-lg font-bold text-gray-700 mb-4 flex items-center">
                <span class="w-2 h-4 bg-indigo-600 rounded-sm inline-block mr-2"></span> Nueva Inscripción
            </h2>
            <form action="/inscripciones/new" method="POST" class="space-y-4">
                <input type="hidden" name="estudiante_id" value="{{estudiante.id}}">
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 uppercase tracking-wider mb-1">Materia Disponible</label>
                        <select name="materia_id" required class="w-full p-2.5 border rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 bg-white">
                            <option value="">-- Elija una materia --</option>
                            {{#materiasDisponibles}}
                            <option value="{{id}}">{{nombre}} (Código: {{codigo_materia}})</option>
                            {{/materiasDisponibles}}
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 uppercase tracking-wider mb-1">Período Académico</label>
                        <select name="periodo" required class="w-full p-2.5 border rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 bg-white">
                            <option value="2026-1C">2026 - 1º Cuatrimestre</option>
                            <option value="2026-2C">2026 - 2º Cuatrimestre</option>
                            <option value="2026-ANUAL">2026 - Anual</option>
                        </select>
                    </div>
                </div>

                <div class="flex justify-end">
                    <button type="submit" class="bg-indigo-600 hover:bg-indigo-700 text-white font-medium py-2 px-6 rounded-lg shadow transition duration-200">
                        Confirmar Inscripción
                    </button>
                </div>
            </form>
        </div>

        <!-- Cursadas actuales -->
        <h3 class="text-lg font-bold text-gray-700 mb-4">Materias Inscriptas</h3>
        <div class="overflow-hidden rounded-lg border border-gray-200 shadow-sm">
            <table class="w-full text-sm text-left text-gray-600">
                <thead class="text-xs text-gray-700 uppercase bg-gray-50 border-b">
                    <tr>
                        <th scope="col" class="px-6 py-3 font-semibold">Materia</th>
                        <th scope="col" class="px-6 py-3 font-semibold">Período</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200 bg-white">
                    {{#inscripciones}}
                    <tr class="hover:bg-gray-50 transition">
                        <td class="px-6 py-4 font-medium text-gray-800">{{materia_nombre}}</td>
                        <td class="px-6 py-4 font-mono">{{periodo}}</td>
                    </tr>
                    {{/inscripciones}}
                    {{^inscripciones}}
                    <tr>
                        <td colspan="2" class="px-6 py-8 text-center text-gray-400 italic bg-gray-50">
                            El estudiante no registra inscripciones en este período todavía.
                        </td>
                    </tr>
                    {{/inscripciones}}
                </tbody>
            </table>
        </div>

        <div class="mt-6 border-t pt-4">
            <a href="/dashboard" class="inline-flex items-center text-sm font-medium text-blue-600 hover:text-blue-800 transition">
                ← Volver al Panel de Control
        <div class="mt-6 border-t pt-4 flex justify-between">
            <a href="/estudiantes" class="inline-flex items-center text-sm font-medium text-blue-600 hover:text-blue-800 transition">
                ← Volver al Listado de Estudiantes
            </a>
            <a href="/dashboard" class="inline-flex items-center text-sm font-medium text-gray-600 hover:text-gray-800 transition">
                Ir al Dashboard
            </a>
        </div>
    </div>
</body>

</html>


