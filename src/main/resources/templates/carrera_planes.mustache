<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Planes de Estudio de {{carrera.nombre}}</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 flex items-center justify-center min-h-screen p-4">
    <div class="bg-white p-8 rounded-lg shadow-lg w-full max-w-4xl">
        <h1 class="text-3xl font-bold text-center text-gray-800 mb-8">Planes de Estudio de {{carrera.nombre}}</h1>
        
        <div class="overflow-hidden rounded-lg border border-gray-200 shadow-sm">
            <table class="w-full text-left border-collapse">
                <thead class="bg-gray-50 border-b border-gray-200">
                    <tr>
                        <th class="py-3 px-6 text-sm font-semibold text-gray-700 uppercase tracking-wider">Código del Plan</th>
                        <th class="py-3 px-6 text-sm font-semibold text-gray-700 uppercase tracking-wider">Nombre del Plan</th>
                        <th class="py-3 px-6 text-sm font-semibold text-gray-700 uppercase tracking-wider">Versión</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200 bg-white">
                    {{#planes}}
                    <tr class="hover:bg-gray-50 transition duration-150">
                        <td class="py-4 px-6 text-sm text-gray-900 font-medium">{{codigo}}</td>
                        <td class="py-4 px-6 text-sm text-gray-700">{{nombre}}</td>
                        <td class="py-4 px-6 text-sm text-gray-700">{{version}}</td>
                    </tr>
                    {{/planes}}
                    
                    {{^planes}}
                    <tr>
                        <td colspan="3" class="py-8 px-6 text-center text-gray-500 italic">
                            No hay planes de estudio registrados para esta carrera todavía.
                        </td>
                    </tr>
                    {{/planes}}
                </tbody>
            </table>
        </div>
        
        <div class="mt-8 flex justify-between">
            <a href="/carreras" class="text-blue-600 hover:text-blue-800 hover:underline transition font-medium">Volver a Carreras</a>
            <a href="/carrera/{{carrera.id}}/gestion-plan" class="text-indigo-600 hover:text-indigo-800 hover:underline transition font-medium">Gestionar Planes</a>
        </div>
    </div>
</body>
</html>
