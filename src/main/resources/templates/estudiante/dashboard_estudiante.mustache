<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Panel Estudiantil</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <nav class="navbar navbar-expand-lg navbar-dark bg-success shadow mb-4">
        <div class="container">
            <a class="navbar-brand fw-bold" href="#">🎓 Portal Estudiantil</a>
            <div class="d-flex">
                <span class="navbar-text text-white me-3">Hola, {{nombre}} {{apellido}}</span>
                <a href="/logout" class="btn btn-outline-light btn-sm">Cerrar Sesión</a>
            </div>
        </div>
    </nav>

    <div class="container">
        <!-- Student Info Header -->
        <div class="card shadow mb-4">
            <div class="card-body bg-white">
                <div class="row align-items-center">
                    <div class="col-md-2 text-center">
                        <span style="font-size: 4rem;">🧑‍🎓</span>
                    </div>
                    <div class="col-md-10">
                        <h3 class="fw-bold mb-1">{{nombre}} {{apellido}}</h3>
                        <p class="text-muted mb-2">Estudiante Universitario</p>
                        <div class="row">
                            <div class="col-md-4">
                                <strong>DNI:</strong> {{dni}}<br>
                                <strong>Legajo:</strong> {{cod_estudiante}}
                            </div>
                            <div class="col-md-8">
                                <strong>Carrera:</strong> {{carrera_nombre}}<br>
                                <strong>Plan de Estudios:</strong> {{plan_nombre}}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <!-- Academic Performance -->
            <div class="col-md-7 mb-4">
                <div class="card shadow">
                    <div class="card-header bg-primary text-white fw-bold">
                        📈 Historial Académico (Materias Aprobadas)
                    </div>
                    <div class="card-body bg-white">
                        <div class="table-responsive">
                            <table class="table table-hover table-striped">
                                <thead>
                                    <tr>
                                        <th>Código</th>
                                        <th>Materia</th>
                                        <th class="text-center">Nota Final</th>
                                        <th>Fecha de Aprobación</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {{#aprobadas}}
                                    <tr>
                                        <td>{{codigo_materia}}</td>
                                        <td>{{materia_nombre}}</td>
                                        <td class="text-center fw-bold text-success">{{nota}}</td>
                                        <td>{{fecha}}</td>
                                    </tr>
                                    {{/aprobadas}}
                                    {{^aprobadas}}
                                    <tr>
                                        <td colspan="4" class="text-center text-muted">No posee materias aprobadas registradas.</td>
                                    </tr>
                                    {{/aprobadas}}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Inscriptions -->
            <div class="col-md-5 mb-4">
                <div class="card shadow">
                    <div class="card-header bg-dark text-white fw-bold">
                        📋 Materias en Cursado (Inscripciones Activas)
                    </div>
                    <div class="card-body bg-white">
                        <div class="table-responsive">
                            <table class="table table-hover table-striped">
                                <thead>
                                    <tr>
                                        <th>Código</th>
                                        <th>Materia</th>
                                        <th>Período</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {{#cursadas}}
                                    <tr>
                                        <td>{{codigo_materia}}</td>
                                        <td>{{materia_nombre}}</td>
                                        <td><span class="badge bg-secondary">{{periodo}}</span></td>
                                    </tr>
                                    {{/cursadas}}
                                    {{^cursadas}}
                                    <tr>
                                        <td colspan="3" class="text-center text-muted">No se encuentra inscrito a ninguna materia.</td>
                                    </tr>
                                    {{/cursadas}}
                                </tbody>
                            </table>
                        </div>
                        <div class="mt-3">
                            <a href="/inscripciones/{{estudiante_id}}" class="btn btn-outline-success btn-sm w-100">✍️ Gestionar Inscripciones a Cursada</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
