<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Iniciar Sesión</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 flex items-center justify-center min-h-screen p-4">
    <div class="bg-white p-8 rounded-lg shadow-lg w-full max-w-md">
        <h1 class="text-3xl font-bold text-center text-gray-800 mb-6">Cargar Profesor</h1>

        {{#successMessage}}
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative mb-4" role="alert">
            <span class="block sm:inline">{{successMessage}}</span>
        </div>
        {{/successMessage}}

        {{#errorMessage}}
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4" role="alert">
            <span class="block sm:inline">{{errorMessage}}</span>
        </div>
        {{/errorMessage}}

        <form action="/profesor/login" method="post" class="space-y-4">
            <div>
                <label for="prof_dni" class="block text-gray-700 text-sm font-medium mb-1">Dni:</label>
                <input type="text" id="prof_dni" name="prof_dni" required
                       class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>
             <div>
                <label for="nro_legajo" class="block text-gray-700 text-sm font-medium mb-1">Numero de legajo:</label>
                <input type="text" id="nro_legajo" name="nro_legajo" required
                       class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>
            <button type="submit"
                    class="w-full bg-blue-600 text-white py-2 px-4 rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2">
                Cargar profesor
            </button>
            <div class="text-center mt-4">
                <p class="text-gray-600 text-sm"> ¿La persona no esta cargada? 
                   <a href="/person/new?returnTo=/profesor/login" class="text-blue-600 hover:underline">Registrar Persona</a>
                </p>
                <a href="/profesor/gestion" class="text-blue-600 hover:underline text-sm mt-2 block">Volver atras</a>
            </div>
        </form>
    </div>
</body>
</html>
</body>
</html>