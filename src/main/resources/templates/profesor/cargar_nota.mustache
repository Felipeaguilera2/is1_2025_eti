<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Carga de Notas - Exámenes Finales</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <div class="container mt-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2>Carga de Notas y Registro de Exámenes Finales</h2>
            <a href="/profesor/gestion" class="btn btn-secondary">Volver al Panel</a>
        </div>

        {{#successMessage}}
        <div class="alert alert-success" role="alert" style="color: #155724; background-color: #d4edda; border-color: #c3e6cb; padding: 12px; margin-bottom: 20px; border-radius: 4px; font-weight: bold;">
            {{successMessage}}
        </div>
        {{/successMessage}}

        {{#errorMessage}}
        <div class="alert alert-danger" role="alert" style="color: #721c24; background-color: #f8d7da; border-color: #f5c6cb; padding: 12px; margin-bottom: 20px; border-radius: 4px; font-weight: bold;">
            {{errorMessage}}
        </div>
        {{/errorMessage}}

        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="card shadow">
                    <div class="card-header bg-primary text-white fw-bold">
                        📝 Formulario de Calificaciones
                    </div>
                    <div class="card-body bg-white">
                        <form action="/profesor/cargar-nota" method="POST">
                            
                            <div class="mb-3">
                                <label for="nro_legajo" class="form-label fw-bold">Su Número de Legajo:</label>
                                <input type="number" class="form-control" id="nro_legajo" name="nro_legajo" placeholder="Ej: 4522" required>
                                <div class="form-text text-muted">Solo los profesores registrados están autorizados.</div>
                            </div>

                            <div class="mb-3">
                                <label for="materia_id" class="form-label fw-bold">Seleccione la Materia:</label>
                                <select class="form-select" id="materia_id" name="materia_id" required>
                                    <option value="" disabled selected>-- Elija una materia --</option>
                                    {{#materias}}
                                    <option value="{{id}}">{{nombre}} (Plan: {{plan_materia}})</option>
                                    {{/materias}}
                                </select>
                            </div>

                            <div class="mb-3">
                                <label for="estudiante_id" class="form-label fw-bold">Seleccione el Estudiante:</label>
                                <select class="form-select" id="estudiante_id" name="estudiante_id" required>
                                    <option value="" disabled selected>-- Elija el estudiante --</option>
                                    {{#estudiantes}}
                                    <option value="{{id}}">{{apellido}}, {{nombre}} [Legajo: {{cod_estudiante}}]</option>
                                    {{/estudiantes}}
                                </select>
                            </div>

                            <div class="mb-3">
                                <label for="nota" class="form-label fw-bold">Nota del Examen:</label>
                                <input type="number" step="0.1" class="form-control" id="nota" name="nota" placeholder="Ej: 8.5" min="1" max="10" required>
                            </div>

                            <div class="mb-3">
                                <label for="fecha" class="form-label fw-bold">Fecha del Examen:</label>
                                <input type="date" class="form-control" id="fecha" name="fecha" required>
                            </div>

                            <button type="submit" class="btn btn-success w-100 mt-3">Registrar en Historial Académico</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>