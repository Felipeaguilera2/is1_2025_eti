<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Baja de Profesores</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <div class="container mt-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2>Baja de Profesores por Legajo</h2>
            <a href="/profesor/gestion" class="btn btn-secondary">Volver al Panel</a>
        </div>

        {{#successMessage}}
        <div class="alert alert-success" role="alert" style="color: #155724; background-color: #d4edda; border-color: #c3e6cb; padding: 12px; margin-bottom: 20px; border-radius: 4px; font-weight: bold;">
            {{successMessage}}
        </div>
        {{/successMessage}}

        {{#errorMessage}}
        <div class="alert alert-danger" role="alert" style="color: #721c24; background-color: #f8d7da; border-color: #f5c6cb; padding: 12px; margin-bottom: 20px; border-radius: 4px; font-weight: bold;">
            {{errorMessage}}
        </div>
        {{/errorMessage}}

        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="card shadow mb-4">
                    <div class="card-body">
                        <h5 class="card-title mb-3">Buscar Profesor para dar de Baja</h5>
                        
                        <form action="/profesor/baja/verificar" method="POST">
                            <div class="mb-3">
                                <label for="nro_legajo" class="form-label">Número de Legajo:</label>
                                <input type="number" class="form-control" id="nro_legajo" name="nro_legajo" placeholder="Ej: 12345" required {{#profesorEncontrado}}disabled{{/profesorEncontrado}}>
                            </div>
                            {{^profesorEncontrado}}
                            <button type="submit" class="btn btn-primary w-100">Verificar Legajo</button>
                            {{/profesorEncontrado}}
                        </form>
                    </div>
                </div>

                {{#profesorEncontrado}}
                <div class="card border-warning shadow">
                    <div class="card-header bg-warning text-dark fw-bold">
                        ⚠️ ¡Advertencia de Eliminación!
                    </div>
                    <div class="card-body bg-white text-center">
                        <p class="fs-5">¿Está seguro de que desea eliminar este profesor de la base de datos?</p>
                        <div class="p-3 mb-3 bg-light rounded text-start">
                            <strong>Legajo a eliminar:</strong> {{legajoEliminar}}<br>
                            <strong>DNI Asociado:</strong> {{dniAsociado}}
                        </div>
                        
                        <div class="d-flex justify-content-center gap-3">
                            <a href="/profesor/baja" class="btn btn-secondary px-4">Cancelar</a>
                            
                            <form action="/profesor/baja/confirmar" method="POST" style="display: inline;">
                                <input type="hidden" name="nro_legajo" value="{{legajoEliminar}}">
                                <button type="submit" class="btn btn-danger px-4">Aceptar</button>
                            </form>
                        </div>
                    </div>
                </div>
                {{/profesorEncontrado}}

            </div>
        </div>
    </div>
</body>
</html>