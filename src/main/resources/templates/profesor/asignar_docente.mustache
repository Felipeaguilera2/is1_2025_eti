<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Asignación de Docentes a Materias - UNRC</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 min-h-screen p-6">
    <div class="max-w-5xl mx-auto bg-white p-8 rounded-xl shadow-lg border border-gray-200">

        <div class="flex justify-between items-center mb-6 pb-4 border-b">
            <h1 class="text-3xl font-extrabold text-gray-800 tracking-tight">Asignación de Equipo Docente</h1>
            <span class="bg-indigo-100 text-indigo-800 text-xs font-semibold px-2.5 py-0.5 rounded-full">Docentes</span>
        </div>

        <!-- Alertas -->
        {{#successMessage}}
        <div class="bg-green-50 border-l-4 border-green-500 text-green-800 p-4 rounded-md mb-4 shadow-sm">
            <p class="text-sm font-medium">{{successMessage}}</p>
        </div>
        {{/successMessage}}

        {{#errorMessage}}
        <div class="bg-red-50 border-l-4 border-red-500 text-red-800 p-4 rounded-md mb-4 shadow-sm">
            <p class="text-sm font-medium">{{errorMessage}}</p>
        </div>
        {{/errorMessage}}

        <!-- Formulario -->
        <div class="bg-gray-50 p-6 rounded-lg border border-gray-200 mb-8">
            <h2 class="text-lg font-bold text-gray-700 mb-4 flex items-center">
                <span class="w-2 h-4 bg-indigo-600 rounded-sm inline-block mr-2"></span> Nueva Asignación Docente
            </h2>
            <form action="/profesor/asignar" method="POST" class="space-y-4">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 uppercase tracking-wider mb-1">Profesor</label>
                        <select name="profesor_dni" required class="w-full p-2.5 border rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 bg-white">
                            <option value="">-- Seleccione Profesor --</option>
                            {{#profesores}}
                            <option value="{{dni}}">{{apellido}}, {{nombre}} (Legajo: {{nro_legajo}})</option>
                            {{/profesores}}
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 uppercase tracking-wider mb-1">Materia</label>
                        <select name="materia_id" required class="w-full p-2.5 border rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 bg-white">
                            <option value="">-- Seleccione Materia --</option>
                            {{#materias}}
                            <option value="{{id}}">{{nombre}} (Plan: {{plan_materia}})</option>
                            {{/materias}}
                        </select>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 uppercase tracking-wider mb-1">Rol Docente</label>
                        <select name="rol" required class="w-full p-2.5 border rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 bg-white">
                            <option value="Jefe de cátedra">Jefe de Cátedra</option>
                            <option value="Ayudante">Ayudante</option>
                            <option value="Jefe de Trabajos Practicos">JTP</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-gray-600 uppercase tracking-wider mb-1">Período</label>
                        <input type="text" name="periodo" placeholder="Ej: 2026-1C, 2026-Bimestre, 2026-Anual" required
                               class="w-full p-2.5 border rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 bg-white">
                    </div>
                </div>

                <div class="flex justify-end">
                    <button type="submit" class="bg-indigo-600 hover:bg-indigo-700 text-white font-medium py-2.5 px-6 rounded-lg shadow transition duration-200">
                        Asignar Docente
                    </button>
                </div>
            </form>
        </div>

        <!-- Listado de asignaciones actuales -->
        <h3 class="text-lg font-bold text-gray-700 mb-4">Equipo Docente Asignado Actualmente</h3>
        <div class="overflow-x-auto rounded-lg border border-gray-200 shadow-sm">
            <table class="w-full text-sm text-left text-gray-600">
                <thead class="text-xs text-gray-700 uppercase bg-gray-50 border-b">
                    <tr>
                        <th scope="col" class="px-6 py-3 font-semibold">Docente</th>
                        <th scope="col" class="px-6 py-3 font-semibold">Materia</th>
                        <th scope="col" class="px-6 py-3 font-semibold">Rol</th>
                        <th scope="col" class="px-6 py-3 font-semibold">Período</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200 bg-white">
                    {{#asignaciones}}
                    <tr class="hover:bg-gray-50 transition">
                        <td class="px-6 py-4 font-medium text-gray-800">{{nombre}} {{apellido}}</td>
                        <td class="px-6 py-4 text-gray-700 font-medium">{{materia_nombre}}</td>
                        <td class="px-6 py-4 text-gray-600">{{rol}}</td>
                        <td class="px-6 py-4 font-mono">{{periodo}}</td>
                    </tr>
                    {{/asignaciones}}
                    {{^asignaciones}}
                    <tr>
                        <td colspan="4" class="px-6 py-10 text-center text-gray-400 italic bg-gray-50">
                            No se registran asignaciones docentes activas en el sistema.
                        </td>
                    </tr>
                    {{/asignaciones}}
                </tbody>
            </table>
        </div>

        <div class="mt-6 border-t pt-4 flex justify-between">
            <a href="/profesor/gestion" class="inline-flex items-center text-sm font-medium text-blue-600 hover:text-blue-800 transition">
                ← Volver a Gestión de Profesores
            </a>
            <a href="/dashboard" class="inline-flex items-center text-sm font-medium text-gray-600 hover:text-gray-800 transition">
                Volver al Panel Principal
            </a>
        </div>
    </div>
</body>
</html>
