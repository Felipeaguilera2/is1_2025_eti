<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - Bienvenido</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body action="/login" class="bg-gray-100 flex items-center justify-center min-h-screen p-4">
    <div class="bg-white p-8 rounded-lg shadow-lg w-full max-w-2xl">
        <h1 class="text-3xl font-bold text-center text-gray-800 mb-6">Gestion de profesores</h1>

        {{#username}}
        <p class="text-xl text-center text-gray-700 mb-8">¡Bienvenido, <span class="font-semibold text-blue-600">{{username}}</span>!</p>
        {{/username}}
        {{^username}}
        <p class="text-xl text-center text-gray-700 mb-8">¡Bienvenido!</p>
        {{/username}}

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
            <div class="bg-green-50 border border-green-200 p-6 rounded-lg text-center shadow-sm">
                <h2 class="text-2xl font-bold text-green-700 mb-3">Alta de profesores</h2>
                <p class="text-gray-600 mb-4">Dar de alta profesores.</p>
                <a href="/profesor/login" class="inline-block bg-green-600 text-white py-2 px-4 rounded-md hover:bg-green-900 transition duration-300">Dar de alta</a>
            </div>
            <div class="bg-red-50 border border-red-200 p-6 rounded-lg text-center shadow-sm">
                <h2 class="text-2xl font-bold text-red-700 mb-3">Baja de profesores</h2>
                <p class="text-gray-600 mb-4">Dar de baja profesores.</p>
                <a href="/profesor/baja" class="inline-block bg-red-600 text-white py-2 px-4 rounded-md hover:bg-red-900 transition duration-300">Dar de baja</a>
            </div>
            <div class="bg-yellow-50 border border-yellow-200 p-6 rounded-lg text-center shadow-sm">
                <h2 class="text-2xl font-bold text-yellow-700 mb-3">Consultar y editar</h2>
                <p class="text-gray-600 mb-4">Consulta y modifica informacion de los profesores</p>
                <a href="/profesor/consulta" class="inline-block bg-yellow-600 text-white py-2 px-4 rounded-md hover:bg-yellow-900 transition duration-300">Editar</a>
            </div>
        </div>

        <div class="text-center mt-6">
            <a href="/dashboard" class="inline-block bg-red-600 text-white py-2 px-6 rounded-md hover:bg-red-700 transition duration-300 text-lg">Volver atras</a>
        </div>
    </div>
</body>
</html>