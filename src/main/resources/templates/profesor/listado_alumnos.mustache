<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Alumnos por Materia</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <div class="container mt-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2>Listado de Alumnos por Materia</h2>
            <a href="/profesor/dashboard" class="btn btn-secondary">Volver al Panel</a>
        </div>

        {{#errorMessage}}
        <div class="alert alert-danger" role="alert" style="color: #721c24; background-color: #f8d7da; border-color: #f5c6cb; padding: 12px; margin-bottom: 20px; border-radius: 4px; font-weight: bold;">
            {{errorMessage}}
        </div>
        {{/errorMessage}}

        <div class="row">
            <!-- Sidebar: Materias asignadas -->
            <div class="col-md-4 mb-4">
                <div class="card shadow">
                    <div class="card-header bg-primary text-white fw-bold">
                        📚 Mis Materias Asignadas
                    </div>
                    <div class="list-group list-group-flush">
                        {{#materias}}
                        <a href="/profesor/listados?materia_id={{id}}" class="list-group-item list-group-item-action {{#selected}}active{{/selected}} d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="mb-0">{{nombre}}</h6>
                                <small class="text-muted {{#selected}}text-white-50{{/selected}}">Cod: {{codigo_materia}}</small>
                            </div>
                            <span class="badge bg-secondary rounded-pill">{{periodo}}</span>
                        </a>
                        {{/materias}}
                        {{^materias}}
                        <div class="p-3 text-muted">No tiene materias asignadas en este periodo.</div>
                        {{/materias}}
                    </div>
                </div>
            </div>

            <!-- Main Panel: Lista de alumnos -->
            <div class="col-md-8">
                {{#selectedMateria}}
                <div class="card shadow">
                    <div class="card-header bg-success text-white fw-bold">
                        👥 Alumnos Inscritos - {{nombre}} (Cod: {{codigo_materia}})
                    </div>
                    <div class="card-body bg-white">
                        <div class="table-responsive">
                            <table class="table table-hover table-striped">
                                <thead>
                                    <tr>
                                        <th>Nombre</th>
                                        <th>Apellido</th>
                                        <th>DNI</th>
                                        <th>Legajo de Estudiante</th>
                                        <th>Período Inscripto</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {{#alumnos}}
                                    <tr>
                                        <td>{{nombre}}</td>
                                        <td>{{apellido}}</td>
                                        <td>{{dni}}</td>
                                        <td>{{cod_estudiante}}</td>
                                        <td>{{periodo}}</td>
                                    </tr>
                                    {{/alumnos}}
                                    {{^alumnos}}
                                    <tr>
                                        <td colspan="5" class="text-center text-muted">No hay alumnos inscriptos en esta materia para este período.</td>
                                    </tr>
                                    {{/alumnos}}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                {{/selectedMateria}}
                {{^selectedMateria}}
                <div class="alert alert-info text-center shadow">
                    👈 Seleccione una de sus materias asignadas a la izquierda para ver el listado de alumnos inscriptos.
                </div>
                {{/selectedMateria}}
            </div>
        </div>
    </div>
</body>
</html>
