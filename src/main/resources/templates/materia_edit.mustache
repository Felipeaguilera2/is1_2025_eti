<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Modificar Materia - UNRC</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 min-h-screen p-6">
    <div class="max-w-2xl mx-auto bg-white p-8 rounded-xl shadow-lg border border-gray-200">
        
        <div class="pb-4 border-b mb-6">
            <h1 class="text-2xl font-bold text-gray-800">Modificar Datos de la Asignatura</h1>
            <p class="text-xs text-gray-500 mt-1">Estás editando las propiedades lógicas del registro académico.</p>
        </div>

        {{#errorMessage}}
        <div class="bg-red-50 border-l-4 border-red-500 text-red-800 p-4 rounded-md mb-4 shadow-sm">
            <p class="text-sm font-medium">{{errorMessage}}</p>
        </div>
        {{/errorMessage}}

        {{#materia}}
        <form action="/materias/edit/{{id}}" method="POST" class="space-y-5">
            <div>
                <label class="block text-xs font-semibold text-gray-500 uppercase">Código de Materia (Inmutable)</label>
                <input type="text" value="{{codigo_materia}}" disabled 
                       class="w-full mt-1 p-2.5 border rounded-lg bg-gray-100 text-gray-500 font-mono cursor-not-allowed">
            </div>

            <div>
                <label class="block text-xs font-semibold text-gray-600 uppercase tracking-wider">Nombre de la Materia</label>
                <input type="text" name="nombre" value="{{nombre}}" required 
                       class="w-full mt-1 p-2.5 border rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition shadow-sm">
            </div>

            <div>
                <label class="block text-xs font-semibold text-gray-600 uppercase tracking-wider">Plan de Estudio</label>
                <input type="text" name="plan_materia" value="{{plan_materia}}" required 
                       class="w-full mt-1 p-2.5 border rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition shadow-sm">
            </div>
            <div class="flex items-center space-x-3 py-2">
                <input type="checkbox" id="es_obligatoria" name="es_obligatoria" 
                       {{#materia.es_obligatoria}}checked{{/materia.es_obligatoria}}
                       class="h-4 w-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500">
                <label for="es_obligatoria" class="text-gray-700 font-semibold">¿Es una materia obligatoria?</label>
            </div>
            <script>
                if ("{{materia.es_obligatoria}}" === "1") {
                    document.getElementById('es_obligatoria').checked = true;
                }
            </script>
            <div class="border-t pt-4">
                <label class="block text-xs font-semibold text-gray-600 uppercase tracking-wider mb-2">Asignar Materias Correlativas</label>
                <p class="text-xs text-gray-400 mb-3">Marcá cuáles asignaturas del sistema son requisitos previos para cursar esta materia.</p>
                
                <div class="bg-gray-50 border rounded-lg p-4 max-h-48 overflow-y-auto space-y-2">
                    {{#todasMaterias}}
                    <label class="flex items-center space-x-3 p-1 hover:bg-gray-100 rounded transition cursor-pointer">
                        <input type="checkbox" name="correlativas" value="{{id}}" 
                               {{#checked}}checked{{/checked}}
                               class="w-4 h-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500">
                        <span class="text-sm text-gray-700 font-medium font-mono">[{{codigo_materia}}]</span>
                        <span class="text-sm text-gray-600">{{nombre}}</span>
                    </label>
                    {{/todasMaterias}}
                    {{^todasMaterias}}
                    <p class="text-xs text-gray-400 italic text-center py-2">No hay otras materias disponibles para enlazar correlatividades.</p>
                    {{/todasMaterias}}
                </div>
            </div>

            <div class="flex items-center justify-end space-x-3 border-t pt-4 mt-6">
                <a href="/materias" class="text-sm font-medium text-gray-500 hover:text-gray-700 transition">
                    Cancelar
                </a>
                <button type="submit" class="bg-yellow-500 hover:bg-yellow-600 text-white font-medium px-5 py-2.5 rounded-lg shadow transition duration-150">
                    Aplicar Cambios
                </button>
            </div>
        </form>
        {{/materia}}
    </div>
</body>
</html>