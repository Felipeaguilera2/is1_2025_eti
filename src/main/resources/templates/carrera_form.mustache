<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registrar Nueva Carrera</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 flex items-center justify-center min-h-screen p-4">
    <div class="bg-white p-8 rounded-lg shadow-lg w-full max-w-md">
        <h1 class="text-3xl font-bold text-center text-gray-800 mb-6">Alta de Carrera</h1>

        {{#error}}
        <div class="bg-red-100 border-l-4 border-red-500 text-red-700 p-4 mb-6 rounded-md shadow-sm" role="alert">
            <p>{{error}}</p>
        </div>
        {{/error}}
        {{#success}}
        <div class="bg-green-100 border-l-4 border-green-500 text-green-700 p-4 mb-6 rounded-md shadow-sm" role="alert">
            <p>¡Carrera registrada con éxito!</p>
        </div>
        {{/success}}

        <form action="/carrera/create" method="POST" class="space-y-5">
            <div>
                <label for="codigo" class="block text-gray-700 font-semibold mb-2">Código de la Carrera:</label>
                <input type="text" id="codigo" name="codigo" required 
                       class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition">
            </div>
            
            <div>
                <label for="nombre" class="block text-gray-700 font-semibold mb-2">Nombre de la Carrera:</label>
                <input type="text" id="nombre" name="nombre" required 
                       class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition">
            </div>
            
            <button type="submit" class="w-full bg-blue-600 text-white font-bold py-3 px-4 rounded-md hover:bg-blue-700 transition duration-300 shadow-md">
                Guardar Carrera
            </button>
        </form>
        
        <div class="mt-6 text-center">
            <a href="/dashboard" class="text-blue-600 hover:text-blue-800 hover:underline transition">Volver al Panel Principal</a>
        </div>
    </div>
</body>
</html>