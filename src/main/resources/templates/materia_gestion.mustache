<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gestión de Materias - UNRC</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 min-h-screen p-6">
    <div class="max-w-5xl mx-auto bg-white p-8 rounded-xl shadow-lg border border-gray-200">
        
        <div class="flex justify-between items-center mb-6 pb-4 border-b">
            <h1 class="text-3xl font-extrabold text-gray-800 tracking-tight">Administración de Materias</h1>
            <span class="bg-blue-100 text-blue-800 text-xs font-semibold px-2.5 py-0.5 rounded-full">Módulo Académico</span>
        </div>

        {{#successMessage}}
        <div class="bg-green-50 border-l-4 border-green-500 text-green-800 p-4 rounded-md mb-4 shadow-sm">
            <p class="text-sm font-medium">{{successMessage}}</p>
        </div>
        {{/successMessage}}
        
        {{#errorMessage}}
        <div class="bg-red-50 border-l-4 border-red-500 text-red-800 p-4 rounded-md mb-4 shadow-sm">
            <p class="text-sm font-medium">{{errorMessage}}</p>
        </div>
        {{/errorMessage}}

        <div class="bg-gray-50 p-6 rounded-lg border border-gray-200 mb-8">
            <h2 class="text-lg font-bold text-gray-700 mb-4 flex items-center">
                <span class="w-2 h-4 bg-blue-600 rounded-sm inline-block mr-2"></span> Registrar Nueva Materia
            </h2>
            <form action="/materias/new" method="POST" class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div>
                    <label class="block text-xs font-semibold text-gray-600 uppercase tracking-wider">Código de Materia</label>
                    <input type="number" name="codigo_materia" placeholder="Ej: 1024" required 
                           class="w-full mt-1 p-2.5 border rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition shadow-sm bg-white">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-gray-600 uppercase tracking-wider">Nombre de la Asignatura</label>
                    <input type="text" name="nombre" placeholder="Ej: Análisis Matemático I" required 
                           class="w-full mt-1 p-2.5 border rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition shadow-sm bg-white">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-gray-600 uppercase tracking-wider">Plan de Estudio</label>
                    <input type="text" name="plan_materia" placeholder="Ej: 2023" required 
                           class="w-full mt-1 p-2.5 border rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition shadow-sm bg-white">
                </div>
                <div class="flex items-center space-x-3 py-2">
                    <input type="checkbox" id="es_obligatoria" name="es_obligatoria" checked
                        class="h-4 w-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500">
                    <label for="es_obligatoria" class="text-gray-700 font-medium text-sm">¿Es una materia obligatoria?</label>
                </div>
                <div class="md:col-span-3 flex justify-end pt-2">
                    <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-medium px-5 py-2.5 rounded-lg shadow transition duration-200">
                        + Guardar Materia
                    </button>
                </div>
            </form>
        </div>

        <div class="overflow-x-auto rounded-lg border border-gray-200 shadow-sm">
            <table class="w-full text-sm text-left text-gray-600">
                <thead class="text-xs text-gray-700 uppercase bg-gray-50 border-b">
                    <tr>
                        <th scope="col" class="px-6 py-3 font-semibold">Código</th>
                        <th scope="col" class="px-6 py-3 font-semibold">Materia</th>
                        <th scope="col" class="px-6 py-3 font-semibold">Plan</th>
                        <th class="py-3 px-6 text-sm font-semibold text-gray-700 uppercase tracking-wider">Tipo</th>
                        <th scope="col" class="px-6 py-3 text-center font-semibold">Acciones</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200 bg-white">
                    {{#materias}}
                    <tr class="hover:bg-gray-50 transition">
                        <td class="px-6 py-4 font-mono font-medium text-gray-900">{{codigo_materia}}</td>
                        <td class="px-6 py-4 font-medium text-gray-800">{{nombre}}</td>
                        <td class="px-6 py-4">{{plan_materia}}</td>
                        <td class="py-4 px-6 text-sm text-gray-700 celda-tipo" data-valor="{{es_obligatoria}}">
                        </td>
                        <td class="px-6 py-4 text-center space-x-2">
                            <a href="/materias/edit/{{id}}" class="inline-flex items-center text-xs bg-yellow-50 hover:bg-yellow-100 text-yellow-700 font-semibold px-3 py-1.5 rounded-md border border-yellow-200 transition">
                                Modificar
                            </a>
                            <a href="/materias/delete/{{id}}" onclick="return confirm('¿Estás seguro de eliminar esta materia? Se borrarán sus relaciones correlativas automáticamente.')" 
                               class="inline-flex items-center text-xs bg-red-50 hover:bg-red-100 text-red-600 font-semibold px-3 py-1.5 rounded-md border border-red-200 transition">
                                Eliminar
                            </a>
                        </td>
                    </tr>
                    {{/materias}}
                    {{^materias}}
                    <tr>
                        <td colspan="4" class="px-6 py-10 text-center text-gray-400 italic bg-gray-50">
                            No hay materias registradas en el sistema actualmente.
                        </td>
                    </tr>
                    {{/materias}}
                </tbody>
            </table>
        </div>

        <div class="mt-6 border-t pt-4">
            <a href="/dashboard" class="inline-flex items-center text-sm font-medium text-blue-600 hover:text-blue-800 transition">
                ← Volver al Panel de Control
            </a>
        </div>
    </div>
    <script>
        // Busca todas las celdas y escribe el texto según el número
        document.querySelectorAll('.celda-tipo').forEach(celda => {
            if (celda.getAttribute('data-valor') === "1") {
                celda.innerText = "Obligatoria";
            } else {
                celda.innerText = "Electiva";
            }
        });
    </script>
</body>
</html>