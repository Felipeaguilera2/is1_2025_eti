<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Listado de Carreras</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 flex items-center justify-center min-h-screen p-4">
    <div class="bg-white p-8 rounded-lg shadow-lg w-full max-w-4xl">
        <h1 class="text-3xl font-bold text-center text-gray-800 mb-8">Carreras Universitarias Registradas</h1>
        
        <div class="mb-6 flex justify-between items-center">
            <p class="text-gray-600">Catálogo actual del sistema.</p>
            <a href="/carrera/new" class="bg-green-600 text-white py-2 px-4 rounded-md hover:bg-green-700 transition duration-300 shadow-sm font-medium">
                + Nueva Carrera
            </a>
        </div>

        <div class="overflow-hidden rounded-lg border border-gray-200 shadow-sm">
            <table class="w-full text-left border-collapse">
                <thead class="bg-gray-50 border-b border-gray-200">
                    <tr>
                        <th class="py-3 px-6 text-sm font-semibold text-gray-700 uppercase tracking-wider">Código</th>
                        <th class="py-3 px-6 text-sm font-semibold text-gray-700 uppercase tracking-wider">Nombre de la Carrera</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200 bg-white">
                    {{#carreras}}
                    <tr class="hover:bg-gray-50 transition duration-150">
                        <td class="py-4 px-6 text-sm text-gray-900 font-medium">{{codigo}}</td>
                        <td class="py-4 px-6 text-sm text-gray-700">{{nombre}}</td>
                    </tr>
                    {{/carreras}}
                    
                    {{^carreras}}
                    <tr>
                        <td colspan="2" class="py-8 px-6 text-center text-gray-500 italic">
                            No hay carreras registradas en el sistema todavía.
                        </td>
                    </tr>
                    {{/carreras}}
                </tbody>
            </table>
        </div>
        
        <div class="mt-8 text-center">
            <a href="/dashboard" class="text-blue-600 hover:text-blue-800 hover:underline transition font-medium">Volver al Panel Principal</a>
        </div>
    </div>
</body>
</html>