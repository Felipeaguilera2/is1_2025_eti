<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gestión de Plan de Estudio - {{carrera.nombre}}</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 flex items-center justify-center min-h-screen p-4">
    <div class="bg-white p-8 rounded-lg shadow-lg w-full max-w-4xl">
        <h1 class="text-3xl font-bold text-center text-gray-800 mb-4">Gestión de Planes de Estudio</h1>
        <h2 class="text-xl text-center text-gray-600 mb-8">{{carrera.nombre}}</h2>

        <!-- Alertas -->
        {{#error}}
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-6" role="alert">
            <span class="block sm:inline">{{error}}</span>
        </div>
        {{/error}}
        {{#success}}
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative mb-6" role="alert">
            <span class="block sm:inline">{{success}}</span>
        </div>
        {{/success}}

        <!-- Formulario Agregar / Editar -->
        <div class="bg-gray-50 p-6 rounded-lg border border-gray-200 mb-8">
            <h3 class="text-lg font-semibold text-gray-700 mb-4">
                {{#editPlan}}Editar Plan de Estudio (Versión actual: {{version}}){{/editPlan}}
                {{^editPlan}}Agregar Nuevo Plan de Estudio{{/editPlan}}
            </h3>
            
            <form action="{{#editPlan}}/carrera/{{carrera.id}}/planes/edit/{{id}}{{/editPlan}}{{^editPlan}}/carrera/{{carrera.id}}/planes/new{{/editPlan}}" method="POST" class="space-y-4">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Código del Plan</label>
                        <input type="text" name="codigo" required value="{{#editPlan}}{{codigo}}{{/editPlan}}" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-indigo-500 focus:border-indigo-500">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Nombre del Plan</label>
                        <input type="text" name="nombre" required value="{{#editPlan}}{{nombre}}{{/editPlan}}" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-indigo-500 focus:border-indigo-500">
                    </div>
                </div>

                {{#editPlan}}
                <div class="flex items-center space-x-3 py-2">
                    <input type="checkbox" id="vigente" name="vigente" 
                           {{#vigente_checked}}checked{{/vigente_checked}}
                           class="h-4 w-4 text-indigo-600 border-gray-300 rounded focus:ring-indigo-500">
                    <label for="vigente" class="text-gray-700 font-semibold text-sm">¿Plan Vigente (Activo para inscripciones)?</label>
                </div>
                {{/editPlan}}
                
                <div class="flex justify-end space-x-3">
                    {{#editPlan}}
                    <a href="/carrera/{{carrera.id}}/gestion-plan" class="bg-gray-300 text-gray-700 py-2 px-4 rounded-md hover:bg-gray-400 transition">Cancelar Edición</a>
                    {{/editPlan}}
                    <button type="submit" class="bg-indigo-600 text-white py-2 px-6 rounded-md hover:bg-indigo-700 transition font-medium">
                        {{#editPlan}}Guardar Cambios (Sube Versión){{/editPlan}}
                        {{^editPlan}}Crear Plan{{/editPlan}}
                    </button>
                </div>
            </form>
        </div>

        <!-- Listado de planes actuales para esta carrera -->
        <h3 class="text-lg font-semibold text-gray-700 mb-4">Planes de Estudio Registrados</h3>
        <div class="overflow-hidden rounded-lg border border-gray-200 shadow-sm mb-6">
            <table class="w-full text-left border-collapse">
                <thead class="bg-gray-50 border-b border-gray-200">
                    <tr>
                        <th class="py-3 px-6 text-sm font-semibold text-gray-700">Código</th>
                        <th class="py-3 px-6 text-sm font-semibold text-gray-700">Nombre</th>
                        <th class="py-3 px-6 text-sm font-semibold text-gray-700">Versión</th>
                        <th class="py-3 px-6 text-sm font-semibold text-gray-700">Estado</th>
                        <th class="py-3 px-6 text-sm font-semibold text-gray-700">Acciones</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200 bg-white">
                    {{#planes}}
                    <tr class="hover:bg-gray-50">
                        <td class="py-4 px-6 text-sm font-medium text-gray-900">{{codigo}}</td>
                        <td class="py-4 px-6 text-sm text-gray-700">{{nombre}}</td>
                        <td class="py-4 px-6 text-sm text-gray-700">{{version}}</td>
                        <td class="py-4 px-6 text-sm text-gray-700">
                            {{#vigente_text}}
                            <span class="text-green-700 bg-green-100 px-2.5 py-0.5 rounded-full text-xs font-semibold">Vigente</span>
                            {{/vigente_text}}
                            {{^vigente_text}}
                            <span class="text-red-700 bg-red-100 px-2.5 py-0.5 rounded-full text-xs font-semibold">No Vigente</span>
                            {{/vigente_text}}
                        </td>
                        <td class="py-4 px-6 text-sm space-x-3">
                            <a href="/carrera/{{carrera.id}}/gestion-plan?edit_plan_id={{id}}" class="text-indigo-600 hover:text-indigo-900 font-medium">Editar</a>
                            <a href="/carrera/{{carrera.id}}/planes/{{id}}/materias" class="text-green-600 hover:text-green-900 font-medium">Gestionar Materias</a>
                        </td>
                    </tr>
                    {{/planes}}
                    {{^planes}}
                    <tr>
                        <td colspan="4" class="py-8 px-6 text-center text-gray-500 italic">No hay planes registrados.</td>
                    </tr>
                    {{/planes}}
                </tbody>
            </table>
        </div>

        <div class="text-center">
            <a href="/carreras" class="text-blue-600 hover:text-blue-800 hover:underline transition font-medium">Volver a Carreras</a>
        </div>
    </div>
</body>
</html>
