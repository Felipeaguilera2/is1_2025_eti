<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Consulta y Edición de Profesores</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <div class="container mt-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2>Consulta y Modificación de Profesores</h2>
            <a href="/profesor/gestion" class="btn btn-secondary">Volver al Panel</a>
        </div>

        <!-- Cartel de Éxito al guardar cambios -->
        {{#successMessage}}
        <div class="alert alert-success" role="alert" style="color: #155724; background-color: #d4edda; border-color: #c3e6cb; padding: 12px; margin-bottom: 20px; border-radius: 4px; font-weight: bold;">
            {{successMessage}}
        </div>
        {{/successMessage}}

        <!-- Cartel de Error o Profesor No Existe -->
        {{#errorMessage}}
        <div class="alert alert-danger" role="alert" style="color: #721c24; background-color: #f8d7da; border-color: #f5c6cb; padding: 12px; margin-bottom: 20px; border-radius: 4px; font-weight: bold;">
            {{errorMessage}}
        </div>
        {{/errorMessage}}

        <div class="row justify-content-center">
            <div class="col-md-6">
                <!-- Formulario de Búsqueda -->
                <div class="card shadow mb-4">
                    <div class="card-body">
                        <h5 class="card-title mb-3">Buscar por Número de Legajo</h5>
                        <form action="/profesor/consulta" method="POST">
                            <div class="mb-3">
                                <label for="nro_legajo" class="form-label">Ingrese el Legajo:</label>
                                <input type="number" class="form-control" id="nro_legajo" name="nro_legajo" placeholder="Ej: 12345" required value="{{legajoBuscado}}">
                            </div>
                            <button type="submit" class="btn btn-primary w-100">Buscar Profesor</button>
                        </form>
                    </div>
                </div>

                <!-- Bloque Unificado de Resultados y Edición -->
                {{#profesorEncontrado}}
                <div class="card border-primary shadow animate__animated animate__fadeIn">
                    <div class="card-header bg-primary text-white fw-bold">
                        ✏️ Datos Personales del Profesor (Legajo: {{legajo}})
                    </div>
                    <div class="card-body bg-white">
                        <form action="/profesor/editar" method="POST" class="space-y-3">
                            <input type="hidden" name="nro_legajo" value="{{legajo}}">
                            <input type="hidden" name="dni" value="{{dni}}">

                                <div class="mb-3">
                                    <label class="form-label text-muted small fw-bold">DNI (No editable):</label>
                                    <input type="text" class="form-control bg-light" value="{{dni}}" readonly disabled>
                                </div>

                                <div class="mb-3">
                                    <label for="nombre" class="form-label text-muted small fw-bold">Nombre:</label>
                                    <div class="input-group">
                                        <input type="text" class="form-control" id="nombre" name="nombre" value="{{nombre}}" readonly required>
                                        <button class="btn btn-outline-secondary" type="button" onclick="habilitarCampo('nombre')">✏️</button>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label for="apellido" class="form-label text-muted small fw-bold">Apellido:</label>
                                    <div class="input-group">
                                        <input type="text" class="form-control" id="apellido" name="apellido" value="{{apellido}}" readonly required>
                                        <button class="btn btn-outline-secondary" type="button" onclick="habilitarCampo('apellido')">✏️</button>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label for="correo" class="form-label text-muted small fw-bold">Correo Electrónico:</label>
                                    <div class="input-group">
                                        <input type="email" class="form-control" id="correo" name="correo" value="{{correo}}" readonly required>
                                        <button class="btn btn-outline-secondary" type="button" onclick="habilitarCampo('correo')">✏️</button>
                                    </div>
                                </div>

                                <div class="d-flex gap-2 mt-4">
                                    <a href="/profesor/consulta" class="btn btn-secondary w-50">Descartar</a>
                                    <button type="submit" class="btn btn-success w-50">Guardar Cambios</button>
                                </div>
                            </form>
                        </form>
                    </div>
                </div>
                {{/profesorEncontrado}}

            </div>
        </div>
    </div>

    <!-- JavaScript para habilitar inputs dinámicamente -->
    <script>
        function habilitarCampo(idCampo) {
            const input = document.getElementById(idCampo);
            if (input.hasAttribute('readonly')) {
                input.removeAttribute('readonly');
                input.focus();
                input.classList.add('border-warning'); // Destaca el campo en edición
            }
        }
    </script>
</body>
</html>